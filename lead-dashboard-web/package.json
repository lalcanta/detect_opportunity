{
  "name": "lead-dashboard-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --ip 0.0.0.0 --d1=DB --compatibility-date=2024-11-01 --persist-to=/tmp/lead-d1-state",
    "dev:test": "wrangler pages dev public --port 8789 --ip 127.0.0.1 --d1=DB --compatibility-date=2024-11-01 --persist-to=/tmp/lead-d1-test-state",
    "db:init:local": "wrangler d1 execute DB --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed.sql",
    "db:init:remote": "wrangler d1 execute lead-dashboard --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute DB --local --persist-to=/tmp/lead-d1-state --file=migrations/0001_leads_status_pending_generation.sql",
    "db:migrate:remote": "wrangler d1 execute lead-dashboard-db --remote --file=migrations/0001_leads_status_pending_generation.sql",
    "deploy": "wrangler pages deploy public",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
