{
  "name": "lead-dashboard-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/require-node22.mjs && wrangler pages dev --cwd=dev-local --ip 0.0.0.0 --d1=DB --compatibility-date=2024-11-01 --persist-to=/tmp/lead-d1-state",
    "dev:test": "node scripts/require-node22.mjs && wrangler pages dev --cwd=dev-local --port 8789 --ip 127.0.0.1 --d1=DB --compatibility-date=2024-11-01 --persist-to=/tmp/lead-d1-test-state",
    "db:local:reset": "node scripts/db-local-reset.mjs",
    "db:rotate-seed-credentials:local": "wrangler d1 execute DB --local --config=wrangler.local.toml --persist-to=/tmp/lead-d1-state --file=migrations/0002_rotate_public_seed_credentials.sql",
    "db:rotate-seed-credentials:remote": "wrangler d1 execute lead-dashboard-db --remote --file=migrations/0002_rotate_public_seed_credentials.sql",
    "deploy": "wrangler pages deploy public",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "wrangler": "^4.156.0"
  }
}
