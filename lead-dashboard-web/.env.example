# Copier vers .dev.vars (local). En production : `wrangler pages secret put <NOM>`
SYNC_SECRET_TOKEN=change-me-long-random-string
PUBLIC_APP_URL=http://localhost:8788

# Alertes "lead chaud" (au choix, les deux possibles)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Stripe (Checkout Session)
STRIPE_SECRET_KEY=
STRIPE_AMOUNT_CENTS=49000
STRIPE_PRODUCT_NAME=Création de site web

# true = répartition round-robin automatique à chaque sync
AUTO_ASSIGN=false

# Google OAuth 2.0 (Connexion Whitelist & Synchro Google Agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
